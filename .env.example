# --- Supabase (lead capture) ---
# Project URL from Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key. SERVER ONLY. Never prefix with NEXT_PUBLIC — it must not
# reach the browser bundle. Used only by app/api/lead/route.ts to insert leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags ---
# When "true", the email-gate API persists the user's (sensitive) quiz answers
# alongside their email for funnel analytics. Set "false" to store email + scores
# only. Default behaviour if unset is to NOT store raw answers (PDPA-safe default).
STORE_ANSWERS=false
